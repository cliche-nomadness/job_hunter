# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 隔离，绝不入库）
# 飞书开放平台 → 你的自建应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书事件订阅页的 Verification Token
FEISHU_VERIFICATION_TOKEN=
# DeepSeek 开放平台 API Key
DEEPSEEK_API_KEY=
# 腾讯文档智能表格 MCP Token（岗位清单数据来源）
TENCENT_MCP_TOKEN=
# 每日推送的岗位意向关键词（逗号分隔，岗位名命中任一才入库/推送）
POSITION_KEYWORDS=AI,算法,大模型,Agent,LLM,机器学习,Python
# 可选：手动指定推送目标（不配则自动发现机器人所在会话）
# FEISHU_OPEN_ID=
# FEISHU_CHAT_ID=
